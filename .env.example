CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
CONTENTFUL_PREVIEW_SECRET=
CONTENTFUL_HOST=

# Secret for POST /api/revalidate (Contentful webhook). Use Authorization: Bearer <value> or x-revalidate-secret header.
CONTENTFUL_REVALIDATE_SECRET=

NEXT_PUBLIC_BASE_URL="https://bgmtl.com"
NEXT_PUBLIC_SITE_NAME="bgmtl.com"

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable
# analytics entirely (the consent banner won't show either). Loaded only after
# the visitor accepts the cookie-consent banner (see components/CookieConsent).
NEXT_PUBLIC_GA_ID=

# View Transitions master toggle (event→detail hero morph + page cross-fade).
# Set to "false" to disable; unset or any other value = enabled.
NEXT_PUBLIC_VIEW_TRANSITIONS=true

CLOUDINARY_CLOUD_NAME=

# Mailchimp Configuration
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=



